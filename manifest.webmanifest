{
  "id": "./",
  "name": "Rivio",
  "short_name": "Rivio",
  "description": "Conseils de pêche selon la météo, carnet de prises, carte des spots et chat pour les pêcheurs de carnassiers et de carpe et leurs groupes de potes.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./#conseils",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b3229",
  "theme_color": "#1f6f5c",
  "categories": [
    "sports",
    "lifestyle",
    "weather"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Ma carte de pêche",
      "short_name": "Ma carte",
      "description": "Afficher ma carte de pêche pour un contrôle",
      "url": "./index.html#ma-carte",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "photos",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}